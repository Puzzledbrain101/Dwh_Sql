ALTER TABLE silver.crm_sales_details ALTER COLUMN sls_ship_dt DATE;
ALTER TABLE silver.crm_sales_details ALTER COLUMN sls_due_dt DATE;

DROP TABLE silver.crm_sales_details;

-- 2. Recreate it with proper DATE data types
CREATE TABLE silver.crm_sales_details (
    sls_ord_num    VARCHAR(50),  -- Adjust data types as per your schema
    sls_prd_key    VARCHAR(50),
    sls_cust_id    INT,
    sls_order_dt   DATE,         -- Configured as DATE
    sls_ship_dt    DATE,         -- Configured as DATE
    sls_due_dt     DATE,         -- Configured as DATE
    sls_sales      NUMERIC(18,2),
    sls_quantity   INT,
    sls_price      NUMERIC(18,2)
);

